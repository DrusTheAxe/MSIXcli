#include <winresrc.h>

#include "Version.h"

#define STR1(x) #x
#define DELIM STR1(.)
#define STR3(a,b,c)     STR1(a) DELIM STR1(b) DELIM STR1(c)

#ifndef MSIXADMIN_RELEASE_MAJOR
#define MSIXADMIN_RELEASE_MAJOR     0
#endif

#ifndef MSIXADMIN_RELEASE_MINOR
#define MSIXADMIN_RELEASE_MINOR     0
#endif

#ifndef MSIXADMIN_RELEASE_PATCH
#define MSIXADMIN_RELEASE_PATCH     0
#endif

#define MSIXADMIN_COMPANY_NAME              "Howard Kapustein"
#define MSIXADMIN_FILENAME                  "MSIXAdmin.exe"
#define MSIXADMIN_LEGAL_COPYRIGHT           "Copyright (c) Howard Kapustein. Licensed under the MIT License. See LICENSE for license information."
#define MSIXADMIN_PRODUCT_NAME              "MSIX Admin"
#define MSIXADMIN_PRODUCT_VERSION           MSIXADMIN_RELEASE_MAJOR, MSIXADMIN_RELEASE_MINOR, MSIXADMIN_RELEASE_PATCH
#define MSIXADMIN_PRODUCT_VERSION_STRING    STR3(MSIXADMIN_RELEASE_MAJOR, MSIXADMIN_RELEASE_MINOR, MSIXADMIN_RELEASE_PATCH)

// Assign default values for things not assigned.

#ifndef VERSIONINFO_FILEVERSION
#define VERSIONINFO_FILEVERSION MSIXADMIN_PRODUCT_VERSION
#endif

#ifndef VERSIONINFO_FILEVERSION_STRING
#define VERSIONINFO_FILEVERSION_STRING  MSIXADMIN_PRODUCT_VERSION_STRING
#endif

#ifndef VERSIONINFO_FILETYPE
#define VERSIONINFO_FILETYPE  VFT_APP
#endif

#ifndef VERSIONINFO_FILEFLAGS
#ifdef _DEBUG
#define VERSIONINFO_FILEFLAGS VS_FF_DEBUG
#else
#define VERSIONINFO_FILEFLAGS 0
#endif
#endif

// Define the version info resource

VS_VERSION_INFO VERSIONINFO
PRODUCTVERSION MSIXADMIN_PRODUCT_VERSION
FILEVERSION VERSIONINFO_FILEVERSION
FILETYPE VERSIONINFO_FILETYPE
FILEFLAGSMASK 0x3fl;
FILEFLAGS VERSIONINFO_FILEFLAGS
FILEOS VOS_NT_WINDOWS32

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",        MSIXADMIN_COMPANY_NAME
            VALUE "FileDescription",    MSIXADMIN_FILENAME
            VALUE "FileVersion",        VERSIONINFO_FILEVERSION_STRING
            VALUE "InternalName",       MSIXADMIN_FILENAME
            VALUE "LegalCopyright",     MSIXADMIN_LEGAL_COPYRIGHT
            VALUE "OriginalFilename",   MSIXADMIN_FILENAME
            VALUE "ProductName",        MSIXADMIN_PRODUCT_NAME
            VALUE "ProductVersion",     MSIXADMIN_PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
