<!-- This is a special MSBuild file that is parsed before everything else when MSBuild detects it in our directory structure.
     Adding Sdk="Microsoft.NET.Sdk" to a project causes NuGet files to be generated very early on, so we need these defines to be here
     to ensure that all of our build output files end up in the same location. -->
<Project InitialTargets="DirectoryBuildPropsInfo" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Due to import ordering inconsistencies between different project types, we import this file from multiple places. -->
  <Import Project="$(MSBuildThisFileDirectory)build\EnsureOutputLayout.props" Condition="$(EnsureOutputLayoutPropsIncluded) == ''" />

  <PropertyGroup>
    <GeneratedFilesDir>$(BaseIntermediateOutputPath)Generated Files\</GeneratedFilesDir>
    <GenerateProjectSpecificOutputFolder>True</GenerateProjectSpecificOutputFolder>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NugetPackageDirectory>$(RepoRoot)\packages</NugetPackageDirectory>

    <!-- Nuget warnings/errors and our need for multiple feeds (Nuget.org and Microsoft proxy)
         * RestoreIgnoreFailedSources=true      => Converts package-source access failures into NU1801 warnings.
                                                   Restore can succeed if all required packages are available elsewhere.
         * NU1507                               => Multiple HTTP package sources are configured with Central Package Management
                                                   without Package Source Mapping. Not a connectivity warning.
         * NU1801                               => A package source could not be accessed, but RestoreIgnoreFailedSources allowed restore to continue.
         * NU1900                               => Vulnerability data could not be retrieved from a source.
                                                   Separate from package restore; RestoreIgnoreFailedSources does not suppress it.
         * NoWarn … NU1507                      => Hides only the multiple-source warning. NU1801 and NU1900 remain visible.
         * WarningsNotAsErrors … NU1801;NU1900  => Keeps those connectivity warnings visible but prevents warnings-as-errors from making them fatal.
         * NoWarn … NU1801;NU1900               => Hides both connectivity warnings, including cases where all vulnerability-data sources are unavailable.
     -->
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1801;NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <!-- The standard props files do not set _DEBUG for the resource compiler -->
  <ItemDefinitionGroup Condition="$(Configuration) == 'Debug'">
    <ResourceCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions);</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <!-- Define our standardardized options for C/C++ builds -->
  <Import Project="$(MSBuildThisFileDirectory)build\Build.Cpp.props" />

  <!-- Emits a low-importance message confirming that this Directory.Build.props was loaded for the current project. -->
  <Target Name="DirectoryBuildPropsInfo">
    <Message Importance="Low" Text="Directory.Build.props loaded for $(MSBuildProjectName) ($(Configuration)|$(Platform))" />
  </Target>
</Project>
